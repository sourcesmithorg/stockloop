# Copy to .env (make env). Never commit .env.
POSTGRES_USER=stockloop
POSTGRES_PASSWORD=change-me-locally
POSTGRES_DB=stockloop
POSTGRES_PORT=5433
DATABASE_URL=postgresql+asyncpg://stockloop:change-me-locally@localhost:5433/stockloop

# AI — Gemini. Two supported routes:
#   1) Vertex AI via ADC (preferred for deployment)
#   2) Gemini API key (GEMINI_API_KEY), sent as x-goog-api-key
# The repo project stockloop-f1a358a9 has billing disabled, so Vertex
# calls fail there with 403 BILLING_DISABLED. southern-receiver-9xtlg
# has billing enabled and is verified working.
GOOGLE_CLOUD_PROJECT=southern-receiver-9xtlg
GOOGLE_CLOUD_REGION=us-central1
GEMINI_MODEL=gemini-2.5-flash
GEMINI_API_KEY=
# AI — provider selection is config-only (no code edit). Exact order in
# api/app/services/ai.py::select_provider():
#   1) NINEROUTER_URL set         -> OpenAI-compatible 9router gateway
#                                    (model = AI_MODEL, default "tiny-worker")
#   2) else GEMINI_API_KEY set    -> Gemini API key route (model = GEMINI_MODEL)
#   3) else GOOGLE_CLOUD_PROJECT  -> Vertex AI via ADC (billing-enabled project)
#   4) else                       -> not configured: POST /api/ai/ask returns
#                                    503; deterministic screens keep working.
# Switch to Gemini later by leaving NINEROUTER_URL empty and setting
# GEMINI_API_KEY (route 2) or the project above (route 3). Switch back by
# setting NINEROUTER_URL again — it wins over both Gemini routes.
# Verified live in this environment: route 1 (tiny-worker). Routes 2/3 are
# NOT verified here — no Gemini key is available, and ADC is unavailable
# inside the api container, so route 3 hangs until the 10s provider timeout.
# 9router gateway: Dashboard -> Keys (NINEROUTER_API_KEY); omit the key only
# when the gateway runs auth-disabled.
NINEROUTER_URL=
NINEROUTER_API_KEY=
# Model routed through 9router (default: tiny-worker).
AI_MODEL=

# BigQuery (optional analytics)
BIGQUERY_DATASET=

# CORS origin for the Vite dev server
WEB_ORIGIN=http://localhost:5173
